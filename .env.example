# AI Multi-Agent Travel Planner - Environment Configuration

# ----------------------------------------------------
# Multi-Agent LLM Configuration
# ----------------------------------------------------
# Google Gemini API Key (Required for live LLM mode; application defaults to deterministic fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional alternative provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Ollama Local LLM (Optional local provider)
OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------
# Security & JWT Secrets
# ----------------------------------------------------
JWT_SECRET=TravelPlannerSuperSecretJwtSigningKeyMustBe256BitsLong2026!
JWT_EXPIRATION_MS=86400000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# ----------------------------------------------------
# Database Configuration (PostgreSQL 16 + pgvector)
# ----------------------------------------------------
# Local profile uses H2 in PostgreSQL mode by default with zero setup required.
# For production or docker-compose, PostgreSQL is configured:
POSTGRES_DB=travelplanner
POSTGRES_USER=traveluser
POSTGRES_PASSWORD=travelpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/travelplanner

# ----------------------------------------------------
# Redis Cache Configuration
# ----------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------
# Server & Frontend Networking
# ----------------------------------------------------
SERVER_PORT=8081
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# ----------------------------------------------------
# Mapbox GL JS (Optional public vector token)
# ----------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
